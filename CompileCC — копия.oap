\\ ----- ALE -----

Operators{Sep="+" Sep="-" Sep="*" Sep="/" Sep="//" Sep="%" Sep="**"
  Sep="&" Sep="&&" Sep="|" Sep="||" Sep="^" Sep="^^" Sep="->" Sep="<-"
  Sep="<" Sep=">" Sep="<=" Sep=">=" Sep="==" Sep="!="
}

\**\OperatorsMk.Set= \\Сопоставление АЛ операции и МК для АЛУ
  >{Sep="+" FUALUNew.Sum}
  >{Sep="-" FUALUNew.Sub}
  >{Sep="*" FUALUNew.Mul}
  >{Sep="/" FUALUNew.Div}
  >{Sep="//" FUALUNew.DivInt}
  >{Sep="%" FUALUNew.Mod}
  >{Sep="**" FUALUNew.Pow}
  >{Sep="&" FUALUNew.And}
  >{Sep="and" FUALUNew.And}
  >{Sep="&&" FUALUNew.AndBit}
  >{Sep="|" FUALUNew.Or}
  >{Sep="or" FUALUNew.Or}
  >{Sep="||" FUALUNew.OrBit}
  >{Sep="^" FUALUNew.Xor}
  >{Sep="xor" FUALUNew.Xor}
  >{Sep="^^" FUALUNew.XorBit}
  >{Sep="->" FUALUNew.MrBit}
  >{Sep="<-" FUALUNew.MlBit}
  >{Sep="<" FUALUNew.Smaller}
  >{Sep=">" FUALUNew.Bigger}
  >{Sep="<=" FUALUNew.SmallerEQ}
  >{Sep=">=" FUALUNew.BiggerEQ}
  >{Sep="==" FUALUNew.EQ}
  >{Sep="!=" FUALUNew.NotEQ}

\**\OperatorsAccumMk.Set= \\Сопоставление АЛ операции и МК для АЛУ
  >{Sep="+=" FUALUNew.Sum Sep="+"}
  >{Sep="-=" FUALUNew.Sub Sep="-"}
  >{Sep="*=" FUALUNew.Mul Sep="*"}
  >{Sep="/=" FUALUNew.Div Sep="/"}
  >{Sep="//=" FUALUNew.DivInt Sep="//"}
  >{Sep="%=" FUALUNew.Mod Sep="%"}
  >{Sep="**=" FUALUNew.Pow Sep="**"}
  >{Sep="&=" FUALUNew.And Sep="&"}
  >{Sep="&&=" FUALUNew.AndBit Sep="&&"}
  >{Sep="|=" FUALUNew.Or Sep="|"}
  >{Sep="||=" FUALUNew.OrBit Sep="||"}
  >{Sep="^=" FUALUNew.Xor Sep="^"}
  >{Sep="^^=" FUALUNew.XorBit Sep="^^"}
  >{Sep="->=" FUALUNew.MrBit Sep="->"}
  >{Sep="<-=" FUALUNew.MlBit Sep="<-"}

\**\ALEPriority.Set= \\Приоритет арифметических операций
>{Sep="**"}
>{Sep="*" Sep="/" Sep="//" Sep="%"}
>{Sep="+" Sep="-"}
>{Sep="<-" Sep="->"}
>{Sep="==" Sep="<>" Sep="<=>" Sep="<" Sep="<=" Sep=">" Sep=">="}
>{Sep="&"}
>{Sep="^"}
>{Sep="|"}
>{Sep="&&"}
>{Sep="||"}
>{Sep="="} // Для сбороса приоритетов АЛ операций

\**\ALEStart.Set=
>{Var Lex.ReceiverMkSet=VarAfter.FindAnd}
>{Mk Lex.ReceiverMkSet=EgAleWait2.FindAnd}
>{Vect Lex.ReceiverMkSet=VectAfter.FindAnd}
>{0 Lex.Stop Console.OutLn="Wrong ALE description"}

Brackets{Sep="(" Sep="[" Sep="{" ALEEnd} \\ Открывающиеся скобки

\**\VarAfter.Set=
>{Sep="++" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="++"
  OAList.LastAtrAttach=ALU_Main.Set ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
  OAList.LastAtrAttach=ALU_Main.Inc
  OAList.LastAtrAttach=ALU_Main.Out ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
}
>{Sep="--" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="--"
  OAList.LastAtrAttach=ALU_Main.Set ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
  OAList.LastAtrAttach=ALU_Main.Dec
  OAList.LastAtrAttach=ALU_Main.Out ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
}
>{Sep="=" Lex.ReceiverMkSet=EqAfter.FindAnd
  OAList.LastAtrAttach=ALU_Main.Calc
  OAList.LineCopyAddPrevLoadSet={FUALUNew.OutAdrAppend}
  ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
  Stack.LineCopyAdd={ALEEnd}
  Console.OutLn="VarAfter ="}
>{Sep=","}
>{0 Console.OutLn="VarAfter else"
  FUListNew.ReceivedOutMk=OperatorsAccumMk.FindAnd
  OperatorsAccumMk.FailExec={
    Lex.Stop
    Console.OutLn="ALE error"
    Stack.OutMk=Console.OutLn
    VarAfter.ProgStopAll
}
  Lex.ReceiverMkSet=AleEqAfter.FindAnd
  OAList.LastAtrAttach=ALU_Main.Calc
  OAList.LineCopyAddPrevLoadSet={FUALUNew.OutAdrAppend}
  ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
  OAList.LastAttach={FUALUNew.Set}
  ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
  OperatorsAccumMk.IpSecondOutMk=OAList.LastAttach
  OAList.LineCopyAddPrevLoadSet={FUALUNew.Set}
  Stack.LineCopyAdd={ALEEnd}
  OperatorsAccumMk.IpLastOutMk=Stack.LineCopyAdd
  Console.OutLn="VarAfter +="
}

\**\EqAfter.Set=
>{Var Lex.ReceiverMkSet=EqAfter2.FindAnd Console.OutLn="EqAfter Var"
  ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet OAList.LastAtrAttach=ALU_Main.Set}
>{Mk Lex.ReceiverMkSet=EqAfter2.FindAnd ALEStart.ReceivedLoadOutMk=ALU_Main.OutMkAppend
  OAList.LastAtrAttach=ALU_Main.OutMkAppend ALEStart.ReceivedLoadOutMk=OAList.LastLoadSet
  Console.OutLn="EqAfter Mk"}
>{0 Console.OutLn="EqAfter else" OAList.LastAtrAttach=FUALUNew.Set FUListNew.ReceivedOutMk=AleEqAfter.FindAnd}

\**\EqAfter2.Set=
>{Sep="=" Lex.ReceiverMkSet=EqAfter.FindAnd Console.OutLn="EqAfter2 ="}
>{0 Console.OutLn="EqAfter2 else" Lex.ReceiverMkSet=AleEqAfter.FindAnd FUListNew.ReceivedOutMk=AleEqAfter.FindAnd}


\**\AleEqAfter.Set=
>{Var Const ConstInt ConstFloat Vect Lex.ReceiverMkSet=OperatWait.FindAnd
  FUListNew.ReceivedLoadOutMk=OAList.LastLoadSet
  Console.OutLn="AleEqAfter Var"
}
>{Sep="(" Lex.ReceiverMkSet=AleEqAfter.FindAnd  Console.OutLn="AleEqAfter ("
  Stack.LineCopyAdd={Sep="("}
  OAList.LineCopyAddPrevLoadSet={FUALUNew.Set}
}
>{0 Console.OutLn="AleEqAfter else" Lex.ReceiverMkSet=AleEqAfter.FindAnd FUListNew.ReceivedOutMk=AleEqAfter.FindAnd}

\**\OperatWait.Set=
>{Sep="}"}
>{Sep=")" Lex.ReceiverMkSet=OperatWait.FindAnd Console.OutLn="OperatWait )"
\\  OAList.OutMk=Console.OutLn
\\  Stack.OutMk=Console.OutLn
  Stack.FailLineProgSet={Stack.LastDelMk Console.OutLn="Not bracket stask del" FUListNew.FindOrLast=Brackets}
  Stack.FindOrLast=Brackets \\Удаление нескобочных знаков
  Stack.FailLineProgSet
  Stack.FindOrLast={Sep="("}
  Stack.SuccessExec={Stack.LastDelMk OAList.LastPopMk}
\\  OAList.OutMk=Console.OutLn
\\  Stack.OutMk=Console.OutLn
}
>{0 Console.OutLn="OperatWait else"
//  Stack.OutMk=Console.OutLn
  FUListNew.ReceivedOutMk=OperatorsMk.FindAnd
  OperatorsMk.FailExec={ \\Не оператор
    Stack.FailLineProgSet={Stack.LastDelMk OAList.LastPopMk Console.OutLn="Not bracket stask del" FUListNew.FindOrLast={ALEEnd Sep="(" Sep="{"}}
    Stack.FindOrLast={ALEEnd Sep="(" Sep="{"} \\Удаление нескобочных знаков
    Stack.FailLineProgSet

    Console.OutLn="ALE ALEEnd finding"
    Stack.OutMk=Console.OutLn
 
    Stack.FindAndLast={ALEEnd}
    Stack.SuccessExec={
      Console.OutLn="ALEEnd success"
      FUListNew.LastDelMk
      OperatWait.ReceivedOutMk=Lex.ReceiverPopSend
      OperatWait.ProgStopAll
	 OperatorsMk.ProgStopAll
    }
    Lex.Stop
    Console.OutLn="ALE error"
    Stack.OutMk=Console.OutLn
  }

  OperatWait.CycleProg={
  Console.OutLn="ALEPriority Cycle"
    FUListNew.ReceivedOutMk=ALEPriority.FindAnd
    Stack.LastOutMk=ALEPriority.FindAnd
    ALEPriority.FailExec={Console.OutLn="ALEPriority Cycle Out"
      OperatWait.ReceivedOutMk=Stack.LineCopyAdd \\ Запомнить приоритет операции
      OperatWait.ProgStop=1
      }
    Console.OutLn="ALEPriority Cycle iteration"
    ALEPriority.EqExec={Console.OutLn="Eg priority" OperatWait.ProgStop=1}
    ALEPriority.SmallerExec={Console.OutLn="Small priority" Stack.LastDelMk
      Stack.FindOrLast=Brackets
      Stack.FailExec={OAList.LastPopMk}
    }
    ALEPriority.BiggerExec={Console.OutLn="Big priority"
      OAList.OutMk=Console.OutLn
      OperatWait.ReceivedOutMk=Stack.LineCopyAdd
      OAList.LastIpOutMk=OAList.LineCopyAddPrevLoadSet	
      OAList.LastAtrSet=FUALUNew.Set
      OAList.OutMk=Console.OutLn
      OperatWait.ProgStop=1
    }
  }
  Lex.ReceiverMkSet=AleEqAfter.FindAnd
  OperatorsMk.IpSecondOutMk=OAList.LastAttach Console.OutLn="OperatorsMk success"
}

\\ ===============

\**\ServiseMk.Set= \\Сервисные МК 
>{NewFUAtr Console.OutLn="CreateNewFU" OAList.LastLoadOutMk=CreateNewFU.FindOr
	OAList.LastLoadOutMk=Main_Bus.DelIc
	OAList.LastDelMk
}

CreateNewFU.MultiLineModeSet=1
\**\CreateNewFU.Set=
>{Mnemo  Console.OutLn="Mnemo NewFU"
	FUListNew.IpReceivedOutMk=MnemoTable.LineCopyAdd}
>{FUTemplate FUListNew.ReceivedLoadOutMk=Main_Bus.MakeFU}
>{FUType Console.OutLn="FUType NewFU" FUListNew.ReceivedIpLoadOutMk=Main_Bus.MakeFU FUListNew.ReceivedOutMk=Console.OutLn
	MnemoTable.LastAttach={MkBegRange}
	FUListNew.IpReceivedOutMk=MnemoTable.FindAnd
	Main_Bus.LastFUMkRangeOutMk=MnemoTable.LastLoadCopySet
//	FUListNew.LoadReceivedOutMk=Main_Bus.LastFUNameSet
//	FUListNew.IpReceivedOutMk=Console.OutLn	
	FUListNew.IpReceivedOutMk=MnemoTable.FindAnd
	MnemoTable.FindAndLine={MkList}
	MnemoTable.IpOutMk=Console.OutLn
	MnemoTable.IpOutMk=MnemoTable.LastAttach
}
>{Hint Console.OutLn="Hint" FUListNew.IpReceivedOutMk=MnemoTable.LastAttach}

\\MnemoTable.ContextOutMk=MnemoPrint.Set
\\MnemoPrint.ContextOutMk=Console.MnemoTableSet \\ Настроить таблицу мнемоник для ФУ консоли
\\MnemoPrint.OutMk=Console.OutLn
\\MnemoTable.OutMk=Console.OutLn
MnemoTable.SuccessProgSet={FUListNew.IpSecondOutMk=Lex.SendToReceiver} \\Передать описание лексемы лексеру
MnemoTable.FailProgSet={Console.OutLn="Mnemo is not faund"
   FUListNew.ReceivedOutMk=Console.OutLn
   FUListNew.ReceivedOutMk=Lex.SendToReceiver}
OAList.LineCopyAdd \\ Начальная ИК для синтезируемого ОА графа

\**\RootRoot.Set=
>EndRoot{End Console.OutLn="End of compiling"}
>RootMk{MkExtend Atr Lex.ReceiverMkSet=EqualWait.FindAnd Console.OutLn="RootMk"
	OAList.LastAttach
	FUListNew.ReceivedLoadOutMk=OAList.LastAtrSet	
}
>RootSep{Sep="." Lex.ReceiverMkSet=MkWait.FindAnd Console.OutLn="RootDot" FUListNew.ReceivedOutMk=Console.OutLn}
>RootFU{MkBegRange Lex.ReceiverMkSet=FUAfter.FindAnd Root.ReceivedLoadOutMk=MkCalc.Set Console.OutLn="RootFU"}
>{Mnemo="if" Lex.ReceiverMkSet 
  
}
>{Mnemo Lex.ReceiverMkSet=MnemoAnalysis.FindAnd Root.ReceivedOutMk=MnemoTable.LineCopyAdd Console.OutLn="RootRootMnemo"}
>ICDel{IC Lex.ReceiverMkSet=DelMnemoIcWait.FindAnd Console.OutLn="RoorRoot Var IC to del"}
>VarDel{Var Lex.ReceiverMkSet=DelMnemoVarWait.FindAnd Console.OutLn="RoorRoot Var IC to del"}
//>{FUType}
>{0 Console.OutLn="Error RR" Lex.Stop FUListNew.ReceivedOutMk=Console.OutLn}

\**\Root.Set=
>RootMk
>RootSep
>RootFU
>EndRoot
>ICDel
>VarDel
>{MkExtend=CreateNewFU.FindOr Lex.Stop Console.OutLn="The command 'CreateNewFU' is avalible only on root level of program"}
>{Sep="}" MnemoTable.ProgsBlock=True Lex.ReceiverMkSet=Root.FindAnd Stack.LastOutMk=ICBrackAnalysis.FindAnd MnemoTable.ProgsBlock=False}
>{0 Lex.Stop Console.OutLn="Error R" FUListNew.ReceivedOutMk=Console.OutLn}
RootMk! RootSep! RootFU! EndRoot!
ICDel! VarDel!

\**\ICBrackAnalysis.Set=
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd
  Console.OutLn="Root }"
  Stack.LastDelMk
  OAList.LastPopMk
  Stack.EmptyExec={Main_Bus.FuSwapNext=Root.Reset Console.OutLn="FU Swap" OAList.LastIpOutMk=ServiseMk.FindAnd}
}
>{Sep=">" Lex.ReceiverMkSet=ListLineAfter.FindAnd
  Console.OutLn="ICBrackAnalysis > }"
  OAList.LastPopMk
  OAList.OutMk=Console.OutLn
}
>{0 Lex.Stop Console.OutLn="'}' without'{'"}

\**\ListLineAfter.Set=
>{Sep=">" Lex.ReceiverMkSet=ListStart.FindAnd
  OAList.LastAttach={Obj}
  Stack.LastDelMk
  Console.OutLn="ListLineAfter >"
}
>{0 Lex.ReceiverMkSet=Root.FindAnd
Stack.OutMk=Console.OutLn
  Stack.LastDelMk OAList.LastPopMk
  Console.OutLn="ListLineAfter else"
Console.OutLn="-----"
OAList.OutMk=Console.OutLn
  Stack.EmptyExec={Main_Bus.FuSwapNext=Root.Reset Console.OutLn="FU Swap"}
  FUListNew.ReceivedOutMk=Root.FindAnd
}

\**\MnemoAnalysis.Set=
>{Sep=">" Lex.ReceiverMkSet=ListStart.FindAnd Console.OutLn="MnemoAnalysis >"
  Main_Bus.FuSwapNext=Root.Reset Console.OutLn="FU Swap"
  OAList.LineCopyAdd={Obj}
  MnemoTable.LastAttach={IC}
  OAList.LastOutMk=MnemoTable.LastLoadSet
}
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="MnemoAnalysis {" 
	MnemoTable.LastAttach={IC}
	OAList.LineCopyAdd OAList.LastOutMk=MnemoTable.LastLoadSet
	Main_Bus.FuSwapNext=Root.Reset
	Console.OutLn="FU swap"
	Stack.LineCopyAdd={Sep="{"}
}
>{Sep="=" Lex.ReceiverMkSet=VarIniWait.FindAnd Console.OutLn="MnemoAnalysis ="}
>{Sep="#" Lex.ReceiverMkSet=AtrWait.FindAnd MnemoTable.LastAttach={Const} Console.OutLn="MnemoAnalysis #"}
>{Sep="*" Lex.ReceiverMkSet=AtrWait.FindAnd MnemoTable.LastAttach={Atr}}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="MnemoAnalysis Free Atr" 
	Root.ReceivedOutMk=MnemoTable.LineCopyAdd MnemoTable.LastAttach={Atr}
	AtrCounter.OutMk=MnemoTable.LastAtrSet
	MnemoAnalysis.ReceivedOutMk=Root.FindAnd
}

\**\ListStart.Set=
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd
  OAList.LineCopyAddPrevLoadSet Stack.LineCopyAdd={Sep=">"}
  Console.OutLn="ListStart {"
  OAList.OutMk=Console.OutLn
}
>{IC Lex.ReceiverMkSet=ListLineAfter.FindAnd Console.OutLn="ListStart IC"}
>{Mnemo Lex.ReceiverMkSet=ListStartMneno.FindAnd Console.OutLn="ListStart Mnemo"
  FUListNew.ReceivedOutMk=MnemoTable.LineCopyAdd MnemoTable.LastAttach={IC}
  OAList.LineCopyAddPrevLoadSet OAList.LastOutMk=MnemoTable.LastLoadSet
}
>{0 Lex.Stop Console.OutLn="List description error"}

\**\ListStartMneno.Set=
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd Stack.LineCopyAdd={Sep=">"}}
>{0 Lex.Stop Console.OutLn="'{' is expected"}

\**\AtrWait.Set=
>{Const ConstFloat ConstInt Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="AtrWait Const"
  FUListNew.ReceivedLoadOutMk=MnemoTable.LastLoadCopySet
}
>{0 Lex.Stop Console.OutLn="Constant is expected"}

\**\ConstWait.Set=
>{Const ConstFloat ConstInt Lex.ReceiverMkSet=Root.FindAnd 
  FUListNew.ReceivedLoadOutMk=MnemoTable.LastLoadCopySet
}
>{0 Lex.Stop Console.OutLn="Constant is expected"}

\**\VarIniWait.Set=
>{Const ConstFloat ConstInt Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="VarIniWait Const"
  MnemoTable.LastAtrAttach=Var
  FUListNew.ReceivedLoadOutMk=MnemoTable.LastLoadCopySet
  MnemoTable.LastVarTypeSet
}
>{0 Lex.Stop Console.OutLn="Constant is expected"}

\**\FUAfter.Set=
>{Sep="." MnemoTable.SubDown=MkList Lex.ReceiverMkSet=MkWait.FindAnd Console.OutLn="FUAfter ."}
//>{Sep="(" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="FUAfter ."}
>{0 Lex.Stop Console.OutLn="'.' or '(' is expected"}

\**\MkWait.Set=
>{Mk Lex.ReceiverMkSet=EqualWait.FindAnd Console.OutLn="MkWait Mk"
	OAList.LastAttach
	FUListNew.ReceivedLoadOutMk=MkCalc.Add
	MkCalc.OutMk=OAList.LastAtrSet
	MnemoTable.SubUp
	//MnemoTable.OutMk=Console.OutLn
	}
>{0 Lex.Stop Console.OutLn="Mk is expected :::" FUListNew.ReceivedOutMk=Console.OutLn}

\**\FUAfter2.Set=
>{Sep="." MnemoTable.SubDown=MkList Lex.ReceiverMkSet=MkWait2.FindAnd Console.OutLn="FUAfter2 ."}
//>{Sep="(" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="FUAfter ."}
>{0 Console.OutLn="'.' or '(' is expected" Lex.Stop}

\**\MkWait2.Set=
>{Mk Lex.ReceiverMkSet=LoadAfterMk.FindAnd Console.OutLn="MkWait2 Mk"
	FUListNew.ReceivedLoadOutMk=MkCalc.Add
	MkCalc.OutMk=OAList.LastLoadCopySet \\ Записать значение нагрузки последней ИП линии
	OAList.LastLoadTypeSet=CMkType
	MnemoTable.SubUp
	//MnemoTable.OutMk=Console.OutLn
	}
>{0 Console.OutLn="Mk is expected" Lex.Stop}



\**\EqualWait.Set=
>{Sep="=" Lex.ReceiverMkSet=EqualAfter.FindAnd Console.OutLn="EqualWait ="}
>{Sep="}" Lex.ReceiverMkSet=Root.FindAnd Lex.SendToReceiver}
>{0 Lex.ReceiverMkSet=Root.FindAnd FUListNew.ReceivedOutMk=Lex.SendToReceiver}

\**\EqualAfter.Set=
>{Mnemo="ans"}
>{Sep="(" Lex.ReceiverMkSet=Root.FindAnd Lex.ReceiverPush=AleEqAfter.FindAnd \\Переход к анализу АЛВ
  OAList.LastAtrSet=ALU_Main.Calc
  OAList.LineCopyAddPrevLoadSet={FUALUNew.OutMkAppend}
  MkCalc.OutMk=OAList.LastLoadCopySet
  OAList.LastAtrAttach=FUALUNew.Set
  Stack.LineCopyAdd={ALEEnd}
  AleEqAfter.FindAnd={Sep="("}
  }
>{Sep=">" Lex.ReceiverMkSet=ListStart.FindAnd Console.OutLn="EqualAfter >"
  Stack.EmptyExec={Main_Bus.FuSwapNext=Root.Reset Console.OutLn="FU Swap" OAList.LastIpOutMk=ServiseMk.FindAnd}
  OAList.LineCopyAddPrevLoadSet={Obj}}
>{Var MkExtend Atr Lex.ReceiverMkSet=DelMnemoWait.FindAnd  Console.OutLn="EqualAfter Const"}
>{Const ConstInt Lex.ReceiverMkSet=EqVar.FindAnd  Console.OutLn="EqualAfter Const"}
>{IC Lex.ReceiverMkSet=DelMnemoIcWait.FindAnd FUListNew.ReceivedLoadOutMk=OAList.LastLoadSet Console.OutLn="EqualAfter IC"}
>{MkBegRange FUTypeDef Lex.ReceiverMkSet=FUAfter2.FindAnd FUListNew.ReceivedLoadOutMk=MkCalc.Set}
>{FUType Lex.ReceiverMkSet=FUAfter2.FindAnd MkCalc.Set=0}
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd OAList.LineCopyAddPrevLoadSet Console.OutLn="EqualAfter {"
	Stack.EmptyExec={Main_Bus.FuSwapNext=Root.Reset Console.OutLn="FU Swap!!!"}
	Stack.LineCopyAdd={Sep="{"} Stack.OutMk=Console.OutLn
}
>{Mnemo Lex.ReceiverMkSet=MnemoLoad.FindAnd Console.OutLn="EqualAfter mnemo" FUListNew.ReceivedOutMk=Console.OutLn MnemoTable.OutMk=Console.OutLn}
>{Sep=">" Lex.ReceiverMkSet= Console.OutLn="EqualAfter >"}
>{0 Console.OutLn="Ip load is expected" Lex.Stop EqualAfter.ReceivedOutMk=Console.OutLn}

\**\DelMnemoWait.Set=
>{Sep="!" Lex.ReceiverMkSet=Root.FindAnd MnemoTable.LineDelMk Console.OutLn="DelMnemoWait !"}
>{0 Lex.ReceiverMkSet=EqVar.FindAnd  Console.OutLn="DelMnemoWait else" FUListNew.ReceivedOutMk=EqVar.FindAnd}

\**\DelMnemoIcWait.Set=
>{Sep="!" Lex.ReceiverMkSet=Root.FindAnd MnemoTable.LineOutMk=Console.OutLn MnemoTable.LinePopMk Console.OutLn="DelIcMnemoWait !"}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="DelIcMnemoWait else" FUListNew.ReceivedOutMk=Root.FindAnd}

\**\DelMnemoVarWait.Set=
>{Sep="!" Lex.ReceiverMkSet=Root.FindAnd MnemoTable.LineOutMk=Console.OutLn MnemoTable.LinePopMk Console.OutLn="DelIcMnemoWait !"}
>{0  Console.OutLn="DelVarMnemoWait else"
  Lex.ReceiverMkSet=Root.FindAnd
  Lex.ReceiverPush=ALEStart.FindAnd Root.ReceivedOutMk=ALEStart.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
}

\**\MnemoLoad.Set=
>{Sep="(" Lex.ReceiverMkSet=LoadVar.FindAnd Console.OutLn="MnemoLoad ("}
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="MnemoLoad {" 
	EqualAfter.ReceivedOutMk=MnemoTable.LineCopyAdd MnemoTable.LastAttach={IC}
	OAList.LineCopyAddPrevLoadSet OAList.LastOutMk=MnemoTable.LastLoadSet
	Stack.LineCopyAdd={Sep="{"}
}
>{0 Lex.Stop Console.OutLn="Wrong mnemonic description"}

LoadVar.Set=
>{Const ConstInt Var MkExtend Atr Mnemo Lex.ReceiverMkSet=BrackLoadVar.FindAnd  Console.OutLn="LoadVar Const"}
>{0 Lex.Stop Console.OutLn="Wrong constant desription"}

BrackLoadVar.Set=
>{Sep=")" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="BrackLoadVar )"
	LoadVar.LoadReceivedOutMk=OAList.LastLoadCopySet
	EqualAfter.ReceivedOutMk=MnemoTable.LineCopyAdd MnemoTable.LastAttach={Var}
	OAList.LastOutMk=MnemoTable.LastLoadSet MnemoTable.LastVarTypeSet \\ Преобразовать ссылку в переменную
}
>{Sep="+" Sep="-" Sep="*" Sep="/" Sep="//" } \\Операторы ДОДЕЛАТЬ!!!

\**\EqVar.Set=
>{Sep="}" Lex.ReceiverMkSet=Root.FindAnd
	EqualAfter.ReceivedLoadOutMk=OAList.LastLoadCopySet
	Console.OutLn="EqVar }"
	FUListNew.ReceivedOutMk=Root.FindAnd
}
\\>{Sep="+" Sep="-" Sep="*" Sep="/" Sep="//" Lex.ReceiverPush=ALEStart.FindAnd Lex.PrevOutMk}
>{0 
  EqVar.ReceivedOutMk=ALEPriority.FindAnd
EqVar.ReceivedOutMk=Console.OutLn
  ALEPriority.FailExec={
    Console.OutLn="EqVar else" Lex.ReceiverMkSet=Root.FindAnd EqualAfter.ReceivedLoadOutMk=OAList.LastLoadSet
    Console.OutLn="EqVar not ALE"
  OAList.OutMk=Console.OutLn EqualAfter.ReceivedOutMk=EqVarTypeSet.FindAnd
    EqVar.ReceivedOutMk=Console.OutLn EqVar.ReceivedOutMk=Root.FindAnd EqVar.ProgStop=1
  }
  Console.OutLn="EqVar ALE"
  Lex.ReceiverMkSet=Root.FindAnd Lex.ReceiverPush=AleEqAfter.FindAnd \\Переход к анализу АЛВ
  OAList.LastAtrSet=ALU_Main.Calc
  OAList.LineCopyAddPrevLoadSet={FUALUNew.OutMkAppend}
  MkCalc.OutMk=OAList.LastLoadCopySet
  OAList.LastAtrAttach=FUALUNew.Set
  Stack.LineCopyAdd={ALEEnd}
  EqualAfter.ReceivedOutMk=AleEqAfter.FindAnd
  EqVar.ReceivedOutMk=Lex.SendToReceiver
  }

EqVarTypeSet.Set= // Список для простановки типа нагрузки
>{Mk OAList.LastLoadTypeSet=CAtrType}
>{Atr OAList.LastLoadTypeSet=CAtrType}

\**\LoadAfterMk.Set=
>{Sep="="}
>{Sep="}" Lex.ReceiverMkSet=Root.FindAnd Lex.SendToReceiver Console.OutLn="LoadAfterMk }"}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="LoadAfterMk else" Lex.OutMk=ConsoleOutLn FUListNew.ReceivedOutMk=Root.FindAnd}

Lex.ReceiverMkSet=Root.FindAnd \\ Настроить начальное состояние распознающего автомата
//Lex.ReceiverMkSet=Console.OutLn

Main_Bus.FuSwapNext=Root.Reset // Поменять местами Root и RootRoot

Str_Gen.ReceiverMkSet=Lex.Lexing
Main_Bus.ArgIndSet=1
Main_Bus.ArgByIndOutMk=Str_Gen.Start

\\Lex.Lexing="NewFU={Mnemo=""Console"" FUType=1} Console.OutLn=""Hellow!"""

//Lex.Lexing="ListNmemo >{Cons.OutLn=10} >{Cons.OutLn=11} Cons.OutLn=ListNmemo ListNmemo!"
