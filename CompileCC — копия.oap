// {Mnemo=""List2"" FUType=5}
//Lex.Lexing="Atr=1"
//Lex.Lexing="Atr=pi"
Lex.SendToReceiver={End} \\ Посылка лексемы-маркера конца файла
\\MnemoTable.ContextOutMk=Console.MnemoTableSet
Console.OutLn="---OAList---"
OAList.OutMk=Console.OutLn

\\Console.OutLn="------"
\\Console.OutLn="Stack:"
\\Stack.OutMk=Console.OutLn
\\Console.OutLn="--------MnemoTable:"
\\MnemoTable.OutMk=Console.OutLn
Stack.FullExec={Console.OutLn="Bracket error"} \\Ошибка расстановки скобок
