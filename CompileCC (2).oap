>{Sep="!" Lex.ReceiverMkSet=Root.FindAnd MnemoTable.LineDelMk Console.OutLn="DelMnemoWait !"}
>{0 Lex.ReceiverMkSet=EqVar.FindAnd  Console.OutLn="DelMnemoWait else" FUListNew.ReceivedOutMk=EqVar.FindAnd}

\**\DelMnemoIcWait.Set=
>{Sep="!" Lex.ReceiverMkSet=Root.FindAnd MnemoTable.LineOutMk=Console.OutLn MnemoTable.LinePopMk Console.OutLn="DelIcMnemoWait !"}
>{0 Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="DelIcMnemoWait else" FUListNew.ReceivedOutMk=Root.FindAnd}

\**\DelMnemoVarWait.Set=
>{Sep="!" Lex.ReceiverMkSet=Root.FindAnd MnemoTable.LineOutMk=Console.OutLn MnemoTable.LinePopMk Console.OutLn="DelIcMnemoWait !"}
>{0  Console.OutLn="DelVarMnemoWait else"
  Lex.ReceiverMkSet=Root.FindAnd
  Lex.ReceiverPush=ALEStart.FindAnd Root.ReceivedOutMk=ALEStart.FindAnd
  FUListNew.ReceivedOutMk=Lex.SendToReceiver
}

\**\MnemoLoad.Set=
>{Sep="(" Lex.ReceiverMkSet=LoadVar.FindAnd Console.OutLn="MnemoLoad ("}
>{Sep="{" Lex.ReceiverMkSet=Root.FindAnd Console.OutLn="MnemoLoad {" 
	EqualAfter.ReceivedOutMk=MnemoTable.LineCopyAdd MnemoTable.LastAttach={IC}
	OAList.LineCopyAddPrevLoadSet OAList.LastOutMk=MnemoTable.LastLoadSet
	Stack.LineCopyAdd={Sep="{"}
}
>{0 Lex.Stop Console.OutLn="Wrong mnemonic description"}

LoadVar.Set=
