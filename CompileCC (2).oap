\**\RootRoot.Set=
>EndRoot{Sep="" Console.OutLn="End of compiling"}
>RootMk{MkExtend Atr Lex.ReceiverMkSet=EqualWait.FindAnd Console.OutLn="RootMk"
	OAList.LastAttach
	FUListNew.ReceivedLoadOutMk=OAList.LastAtrSet	
}
>RootSep{Sep="." Lex.ReceiverMkSet=MkWait.FindAnd Console.OutLn="RootDot" FUListNew.ReceivedOutMk=Console.OutLn}
>RootFU{MkBegRange Lex.ReceiverMkSet=FUAfter.FindAnd Root.ReceivedLoadOutMk=MkCalc.Set Console.OutLn="RootFU"}
>RootFUType{FUType Lex.ReceiverMkSet=FUAfter.FindAnd MkCalc.Set=0 Console.OutLn="RootFUType"}

>RootIf{Mnemo="if" Lex.ReceiverMkSet=IfAfter.FindAnd Lex.ReceiverPush=AleEqAfter.FindAnd
