  Stack.LineCopyAdd={IfAtr}
  Stack.LineCopyAdd={ALEEnd}
  OAList.LastAttach={FUALUNew.PushExec}
  OAList.LineCopyAddPrevLoadSet={FUALUNew.Calc}
  OAList.LineCopyAddPrevLoadSet={FUALUNew.Set}
  Console.OutLn="Root if"
}
