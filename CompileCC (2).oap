  Stack.LineCopyAdd={Mnemo="for"}
  Console.OutLn="for Root"
}
>RootAfter{Mnemo="after" Lex.ReceiverMkSet=ForAfter.FindAnd
  OAList.LastAttach={FUALUNew.PushExec}
  OAList.LineCopyAddPrevLoadSet
  Stack.LineCopyAdd={Mnemo="after"}
  Console.OutLn="after"
}

